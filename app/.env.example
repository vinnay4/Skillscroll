# SkillScroll — all integrations are optional; unset values fall back to
# local demo mode / no-op.

# Supabase backend (schema in supabase/ at the repo root)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PostHog analytics (PRD 14.4 events fire automatically once set)
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_key
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry crash reporting (REQ-024)
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
